# Documentation only.
# Docker Compose defines all runtime environment variables inline in docker-compose.yml.

APP_ENV=dev
APP_SECRET=changeme_app_secret
DB_HOST=mysql
DB_PORT=3306
DB_NAME=regops
DB_USER=regops_user
DB_PASSWORD=regops_password
JWT_PASSPHRASE=changeme_jwt_passphrase
LICENSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
DUPLICATE_SIMILARITY_THRESHOLD=80
APPOINTMENT_SLOT_MINUTES=30
APPOINTMENT_HOLD_MINUTES=5
ALERT_REJECTION_THRESHOLD=5
ALERT_REJECTION_WINDOW_HOURS=24
